{
  "name": "xRetro",
  "short_name": "xRetro",
  "description": "Retro-style arcade games for the whole family. Controllers, keyboard and touch.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "landscape",
  "background_color": "#0b0c10",
